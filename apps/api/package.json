{
  "name": "@monorepo-base/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node --env-file=../../.env ../../node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
